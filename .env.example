# MOSS environment configuration
# Copy to `.env` and fill in values, then run `scripts/setup.sh`.

# ============================================================================
# Required: main agent model (used by OpenClaw chat AND evolution trial worker)
# ============================================================================
# Any openai-completions-compatible endpoint. Examples:
#   OpenAI            → https://api.openai.com/v1
#   Anthropic (proxy) → https://api.anthropic.com/v1   (requires proxy w/ completions shim)
#   DeepSeek          → https://api.deepseek.com/v1
#   Ollama (local)    → http://localhost:11434/v1
MOSS_MODEL_BASE_URL=
MOSS_MODEL_API_KEY=

# Model id served by the endpoint above (e.g. gpt-4o, deepseek-chat).
MOSS_MODEL_ID=

# ============================================================================
# Auto-filled by setup.sh on first run — leave blank, don't set manually
# ============================================================================
# Filesystem root of moss/ (for docker bind mounts).
MOSS_HOST_ROOT=

# Path to moss/openclaw/ on host (for src/dist mounts).
MOSS_OPENCLAW_REPO_DIR=

# ============================================================================
# Defaults — override only if you need to
# ============================================================================
# Where MOSS persists state (evolution loops, agents, sessions).
MOSS_DATA_DIR=${HOME}/.moss

# Unix socket the host-daemon exposes for in-container RPC.
MOSS_DAEMON_SOCK=/tmp/moss.sock

# ============================================================================
# Optional: docker invocation
# ============================================================================
# Default is `docker` (assumes user in docker group).
# MOSS_DOCKER_BIN=docker

# ============================================================================
# Optional: Claude CLI integration (used by per-role agent spawns)
# ============================================================================
# Path to the claude binary. Defaults to PATH lookup. Override to an
# absolute path if installed outside PATH (e.g. a wrapper script).
# CLAUDE_BIN=claude

# Path to a Claude Code settings.json (overrides the repo-bundled default).
# MOSS_CLAUDE_SETTINGS=

# ============================================================================
# Optional: starting commit (set by setup.sh on first run)
# ============================================================================
# MOSS_H_PRE=
# MOSS_PYTHON=python3

# ============================================================================
# Optional: which coding-agent CLI evolution role spawns use
# ============================================================================
# Built-in providers: claude (default), codex, deepseek-tui, opencode.
# MOSS_AGENT_PROVIDER=claude

# Codex-specific (used when MOSS_AGENT_PROVIDER=codex)
# Model passed to Codex via -m; also used by TS to look up token→USD pricing
# in openclaw.json (no pricing config = USD reported as 0, tokens shown in UI).
# MOSS_CODEX_MODEL=gpt-5.4
# CODEX_BIN=codex

# ============================================================================
# Optional: DeepSeek-TUI provider (set MOSS_AGENT_PROVIDER=deepseek-tui)
# ============================================================================
# Path to the deepseek-tui binary. Defaults to PATH lookup. Override to an
# absolute path if installed outside PATH.
# DEEPSEEK_TUI_BIN=deepseek-tui

# Path to your deepseek-tui config.toml (contains provider + model + auth
# setup). MOSS reads it, injects its own instructions reference, writes a
# per-spawn tmp config. Default is deepseek-tui's own convention.
# MOSS_DEEPSEEK_CONFIG_TEMPLATE=${HOME}/.deepseek/config.toml

# Optional model name override applied to each spawn's tmp config. If unset,
# MOSS uses the template's `default_text_model` field.
# MOSS_DEEPSEEK_MODEL=

# ============================================================================
# Optional: OpenCode provider (set MOSS_AGENT_PROVIDER=opencode)
# ============================================================================
# Path to the opencode binary. Defaults to PATH lookup.
# OPENCODE_BIN=opencode

# Model passed to opencode via --model. Format is `provider/model-id`.
# Pin explicitly; otherwise opencode silently auto-selects a free model.
# MOSS_OPENCODE_MODEL=anthropic/claude-sonnet-4-6

# Optional reasoning-effort variant. See `opencode models --verbose`.
# MOSS_OPENCODE_VARIANT=

# Authentication: provider env vars (ANTHROPIC_API_KEY, DEEPSEEK_API_KEY,
# OPENAI_API_KEY, ...) or `opencode auth login`. MOSS does not manage these.
